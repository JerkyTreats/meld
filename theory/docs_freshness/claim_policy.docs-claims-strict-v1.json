    "scope": {
      "operator": "document_per_source_directory_v1",
      "document_name": "README.md",
      "exclude_document_names_case_insensitive": true,
      "exclude_hidden_directories": true,
      "excluded_directory_names": [
        ".git",
        ".venv",
        ".tox",
        ".mypy_cache",
        ".pytest_cache",
        ".ruff_cache",
        "node_modules",
        "target",
        "__pycache__"
      ],
      "comparison": "directory_subtree_v1",
      "capture_limits": {
        "maximum_directories": 64,
        "maximum_file_bytes": 8192,
        "maximum_directory_evidence_bytes": 24576,
        "maximum_child_readme_bytes": 3072,
        "maximum_revision_report_chars": 8192
      }
    },
    "claim_extraction": "markdown_sentences_v2"
