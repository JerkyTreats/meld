          "byte_length": 435,
          "content_hash": "9422aee782bcbdbf609681770e026841dd909f36be41584eddc89481e3a20fd4",
          "path": "pricing.py",
          "text": "\"\"\"Calculate order totals in integer cents.\"\"\"\n\nSHIPPING_CENTS = 500\nFREE_SHIPPING_MINIMUM_CENTS = 8000\n\n\ndef total_cents(subtotal_cents: int) -> int:\n    \"\"\"Reject negative subtotals; shipping is free at 8000 cents or more.\"\"\"\n    if subtotal_cents < 0:\n        raise ValueError(\"subtotal must be nonnegative\")\n    shipping = 0 if subtotal_cents >= FREE_SHIPPING_MINIMUM_CENTS else SHIPPING_CENTS\n    return subtotal_cents + shipping\n"
        }
      ]
    },
